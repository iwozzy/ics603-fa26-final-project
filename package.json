{
  "name": "wayfinder",
  "version": "0.1.0",
  "private": true,
  "main": "client/index.ts",
  "scripts": {
    "web": "expo start --web --localhost",
    "build:web": "expo export --platform web",
    "api": "uv run uvicorn wayfinder.runtime:create_app --factory --app-dir backend --host 127.0.0.1 --port 8000 --no-access-log",
    "typecheck": "tsc --noEmit",
    "test:api": "uv run pytest backend/tests",
    "test:web": "npm run build:web && playwright test",
    "test": "npm run test:api && npm run test:web",
    "contract": "uv run python scripts/export_contract.py && json2ts -i client/api.schema.json -o client/api.generated.ts --bannerComment ''",
    "check:python": "uv run ty check backend scripts tests/support && uv run ruff check backend scripts tests/support",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "^58.0.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "~19.3.0",
    "ajv": "^8.17.1",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "~6.0.3"
  }
}
