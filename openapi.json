{
  "components": {
    "schemas": {
      "CatalogProvider": {
        "enum": [
          "tmdb"
        ],
        "title": "CatalogProvider",
        "type": "string"
      },
      "FollowPersonRequest": {
        "additionalProperties": false,
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/CatalogProvider"
          },
          "provider_id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9007199254740991.0,
            "title": "Provider Id",
            "type": "integer"
          }
        },
        "required": [
          "provider",
          "provider_id"
        ],
        "title": "FollowPersonRequest",
        "type": "object"
      },
      "FollowingResponse": {
        "properties": {
          "limit": {
            "const": 3,
            "title": "Limit",
            "type": "integer"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/PersonResponse"
            },
            "maxItems": 3,
            "title": "People",
            "type": "array"
          }
        },
        "required": [
          "people",
          "limit"
        ],
        "title": "FollowingResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MovieSummaryResponse": {
        "properties": {
          "id": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Id",
            "type": "integer"
          },
          "overview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overview"
          },
          "poster_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Image Url"
          },
          "release_date": {
            "format": "date",
            "title": "Release Date",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "overview",
          "poster_image_url",
          "release_date"
        ],
        "title": "MovieSummaryResponse",
        "type": "object"
      },
      "PersonResponse": {
        "properties": {
          "known_for": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 3,
            "title": "Known For",
            "type": "array"
          },
          "known_for_department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Known For Department"
          },
          "name": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name",
            "type": "string"
          },
          "profile_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Image Url"
          },
          "provider": {
            "$ref": "#/components/schemas/CatalogProvider"
          },
          "provider_id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9007199254740991.0,
            "title": "Provider Id",
            "type": "integer"
          }
        },
        "required": [
          "provider",
          "provider_id",
          "name",
          "known_for_department",
          "profile_image_url",
          "known_for"
        ],
        "title": "PersonResponse",
        "type": "object"
      },
      "SearchPeopleResponse": {
        "properties": {
          "people": {
            "items": {
              "$ref": "#/components/schemas/PersonResponse"
            },
            "maxItems": 7,
            "title": "People",
            "type": "array"
          },
          "query": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query",
          "people"
        ],
        "title": "SearchPeopleResponse",
        "type": "object"
      },
      "TimelineDirection": {
        "enum": [
          "older",
          "newer"
        ],
        "type": "string"
      },
      "TimelineResponse": {
        "properties": {
          "anchor_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchor Index"
          },
          "as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/MovieSummaryResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "newer_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Newer Cursor"
          },
          "older_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Older Cursor"
          }
        },
        "required": [
          "items",
          "older_cursor",
          "newer_cursor",
          "as_of",
          "anchor_index"
        ],
        "title": "TimelineResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Lumiere",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/following": {
      "delete": {
        "operationId": "unfollowPerson",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FollowPersonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "500": {
            "description": "Following failed"
          }
        },
        "summary": "Unfollow Person"
      },
      "get": {
        "operationId": "listFollowing",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FollowingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "description": "Following failed"
          }
        },
        "summary": "List Following"
      },
      "post": {
        "operationId": "followPerson",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FollowPersonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FollowingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "description": "Following failed"
          }
        },
        "summary": "Follow Person"
      }
    },
    "/api/v1/guest-session": {
      "post": {
        "operationId": "bootstrapGuestSession",
        "responses": {
          "200": {
            "description": "Successful Response",
            "headers": {
              "X-Lumiere-Guest-Created": {
                "description": "Whether bootstrap created a guest profile",
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Bootstrap failed"
          }
        },
        "summary": "Bootstrap"
      }
    },
    "/api/v1/people/search": {
      "get": {
        "operationId": "searchPeople",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "title": "Query",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPeopleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "description": "Search failed"
          }
        },
        "summary": "Search"
      }
    },
    "/api/v1/timeline": {
      "get": {
        "operationId": "listTimeline",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TimelineDirection"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Direction"
            }
          },
          {
            "in": "query",
            "name": "anchor_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Anchor Date"
            }
          },
          {
            "in": "query",
            "name": "anchor_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Anchor Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "description": "Timeline failed"
          }
        },
        "summary": "List Timeline"
      }
    }
  }
}
