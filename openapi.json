{
  "components": {
    "schemas": {
      "CatalogProvider": {
        "enum": [
          "tmdb"
        ],
        "title": "CatalogProvider",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PersonResponse": {
        "properties": {
          "known_for": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "maxItems": 3,
            "title": "Known For",
            "type": "array"
          },
          "known_for_department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Known For Department"
          },
          "name": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name",
            "type": "string"
          },
          "profile_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Image Url"
          },
          "provider": {
            "$ref": "#/components/schemas/CatalogProvider"
          },
          "provider_id": {
            "exclusiveMinimum": 0.0,
            "maximum": 9007199254740991.0,
            "title": "Provider Id",
            "type": "integer"
          }
        },
        "required": [
          "provider",
          "provider_id",
          "name",
          "known_for_department",
          "profile_image_url",
          "known_for"
        ],
        "title": "PersonResponse",
        "type": "object"
      },
      "SearchPeopleResponse": {
        "properties": {
          "people": {
            "items": {
              "$ref": "#/components/schemas/PersonResponse"
            },
            "maxItems": 7,
            "title": "People",
            "type": "array"
          },
          "query": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query",
          "people"
        ],
        "title": "SearchPeopleResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Lumiere",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/guest-session": {
      "post": {
        "operationId": "bootstrapGuestSession",
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "500": {
            "description": "Bootstrap failed"
          }
        },
        "summary": "Bootstrap"
      }
    },
    "/api/v1/people/search": {
      "get": {
        "operationId": "searchPeople",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "title": "Query",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPeopleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "description": "Search failed"
          }
        },
        "summary": "Search"
      }
    }
  }
}
