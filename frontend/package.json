{
  "name": "lumiere",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "web": "expo start --web --localhost",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:web && playwright test",
    "contract": "uv run --directory ../backend python scripts/export_contract.py && json2ts -i src/api.schema.json -o src/api.generated.ts --bannerComment ''",
    "smoke:live": "node scripts/smoke-live.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "^58.0.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "~19.3.0",
    "ajv": "^8.17.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "10.1.8",
    "json-schema-to-typescript": "^15.0.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  }
}
