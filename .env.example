# Documentation placeholders only. No command automatically loads this file.
DATABASE_URL=<pooled-postgresql+psycopg-url>
MIGRATION_DATABASE_URL=<direct-postgresql+psycopg-url>
TMDB_ACCESS_TOKEN=<operator-supplied>
IP_HASH_KEY=<operator-supplied-stable-random-value>
TRUSTED_PROXY_CIDRS=<JSON-array-of-ingress-network-CIDRs>
GLOBAL_REQUESTS_PER_MINUTE=<positive-integer>
SESSION_REQUESTS_PER_MINUTE=<positive-integer>
IP_REQUESTS_PER_MINUTE=<positive-integer>
BOOTSTRAP_REQUESTS_PER_IP_PER_MINUTE=<positive-integer>
GLOBAL_PROVIDER_DAILY=<positive-integer>
SESSION_PROVIDER_DAILY=<positive-integer>
IP_PROVIDER_DAILY=<positive-integer>
GLOBAL_PROVIDER_TOTAL=<positive-integer>
SESSION_PROVIDER_TOTAL=<positive-integer>
IP_PROVIDER_TOTAL=<positive-integer>
SITE_ADDRESS=<local-listen-address-or-TLS-domain>
TELEMETRY_ENABLED=<true-or-false>
OTEL_EXPORTER_OTLP_ENDPOINT=<operator-OTLP-endpoint>
OTEL_EXPORTER_OTLP_HEADERS=<operator-OTLP-authorization-headers>
