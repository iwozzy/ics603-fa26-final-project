# Documentation placeholders only. No command automatically loads this file.
LUMIERE_DATABASE_URL=<pooled-postgresql+psycopg-url>
LUMIERE_MIGRATION_DATABASE_URL=<direct-postgresql+psycopg-url>
LUMIERE_TMDB_ACCESS_TOKEN=<operator-supplied>
LUMIERE_IP_HASH_KEY=<operator-supplied-stable-random-value>
LUMIERE_TRUSTED_PROXY_CIDRS=<JSON-array-of-ingress-network-CIDRs>
LUMIERE_GLOBAL_REQUESTS_PER_MINUTE=<positive-integer>
LUMIERE_SESSION_REQUESTS_PER_MINUTE=<positive-integer>
LUMIERE_IP_REQUESTS_PER_MINUTE=<positive-integer>
LUMIERE_BOOTSTRAP_REQUESTS_PER_IP_PER_MINUTE=<positive-integer>
LUMIERE_GLOBAL_PROVIDER_DAILY=<positive-integer>
LUMIERE_SESSION_PROVIDER_DAILY=<positive-integer>
LUMIERE_IP_PROVIDER_DAILY=<positive-integer>
LUMIERE_GLOBAL_PROVIDER_TOTAL=<positive-integer>
LUMIERE_SESSION_PROVIDER_TOTAL=<positive-integer>
LUMIERE_IP_PROVIDER_TOTAL=<positive-integer>
LUMIERE_SITE_ADDRESS=<local-listen-address-or-TLS-domain>
LUMIERE_SEARCH_CACHE_MAX_AGE_SECONDS=<positive-integer-default-300>
LUMIERE_TELEMETRY_ENABLED=<true-or-false>
OTEL_EXPORTER_OTLP_ENDPOINT=<operator-OTLP-endpoint>
OTEL_EXPORTER_OTLP_HEADERS=<operator-OTLP-authorization-headers>
OTEL_RESOURCE_ATTRIBUTES=<comma-separated-resource-attributes-e.g.-deployment.environment.name=local>
